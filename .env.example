# ─── Database ──────────────────────────────────────────────────
DATABASE_URL="postgresql://ascenda:password@localhost:5432/ascenda_dev?schema=public"
SHADOW_DATABASE_URL="postgresql://ascenda:password@localhost:5432/ascenda_shadow?schema=public"

# ─── JWT ───────────────────────────────────────────────────────
JWT_ACCESS_SECRET="change-me-to-a-random-256-bit-secret"
JWT_REFRESH_SECRET="change-me-to-a-different-random-256-bit-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Redis ─────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Object Storage (S3-compatible) ────────────────────────────
STORAGE_ENDPOINT="https://s3.amazonaws.com"
STORAGE_BUCKET="ascenda-documents"
STORAGE_ACCESS_KEY="your-access-key"
STORAGE_SECRET_KEY="your-secret-key"
STORAGE_REGION="eu-west-1"

# ─── API ───────────────────────────────────────────────────────
API_PORT=3001
API_PREFIX="api/v1"
CORS_ORIGIN="http://localhost:3000"

# ─── Web ───────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
NEXT_PUBLIC_APP_NAME="Ascenda"

# ─── Email (transactional) ─────────────────────────────────────
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="noreply@ascenda.io"
SMTP_PASS="your-smtp-password"
FROM_EMAIL="Ascenda <noreply@ascenda.io>"

# ─── App ───────────────────────────────────────────────────────
NODE_ENV="development"
LOG_LEVEL="debug"
