# ─── Database (Supabase) ───────────────────────────────────────
# Copy the "Session pooler" string from Supabase → Connect and fill in the ref/password.
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require"
SHADOW_DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require"

# ─── JWT ───────────────────────────────────────────────────────
JWT_ACCESS_SECRET="change-me-to-a-random-256-bit-secret"
JWT_REFRESH_SECRET="change-me-to-a-different-random-256-bit-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Redis ─────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Object Storage (S3-compatible) ────────────────────────────
# Local disk is development-only. Production requires s3 and a PRIVATE bucket.
STORAGE_DRIVER="local"
# STORAGE_LOCAL_DIR="C:/ascenda-data/documents"
STORAGE_ENDPOINT="https://s3.amazonaws.com"
STORAGE_BUCKET="ascenda-documents"
STORAGE_ACCESS_KEY="your-access-key"
STORAGE_SECRET_KEY="your-secret-key"
STORAGE_REGION="eu-west-1"
STORAGE_FORCE_PATH_STYLE=false
# ClamAV clamd INSTREAM service, reachable only over a private/trusted network.
# Production uploads fail closed when this is missing or unavailable.
DOCUMENT_SCAN_HOST=""
DOCUMENT_SCAN_PORT=3310
DOCUMENT_SCAN_REQUIRED=false

# ─── API ───────────────────────────────────────────────────────
API_PORT=3001
API_PREFIX="api/v1"
API_PUBLIC_URL="http://localhost:3001"
CORS_ORIGIN="http://localhost:3000"

# ─── Web ───────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
NEXT_PUBLIC_APP_NAME="Ascenda"

# ─── Email (transactional) ─────────────────────────────────────
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="noreply@ascenda.io"
SMTP_PASS="your-smtp-password"
FROM_EMAIL="Ascenda <noreply@ascenda.io>"

# ─── Payments (subscriptions) ──────────────────────────────────
# PAYMENTS_ENABLED: false pauses checkout — paid plans activate without payment
# (useful while building the product). Set to true to require checkout.
PAYMENTS_ENABLED="false"
# Paystack: secret key from Dashboard → Settings → API Keys (sk_test_... / sk_live_...)
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Flutterwave: secret key (FLWSECK_TEST-...) and the webhook secret hash.
FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxx"
FLUTTERWAVE_WEBHOOK_HASH="your-flutterwave-webhook-hash"
# Public URL the gateways should redirect back to after checkout.
WEB_APP_URL="http://localhost:3000"

# ─── Encryption & background jobs ──────────────────────────────
# Base64 of a 32-byte key (or a 32-char passphrase). Encrypts worker bank
# details and payout provider credentials. Production MUST set a real key;
# development falls back to a deterministic key when this is empty.
BANK_ENCRYPTION_KEY=""
# Employer payroll funding setup requires this key explicitly, even in development.
# The employer funding provider boundary is currently closed pending partner
# approval and a reviewed adapter. Subscription keys above do not activate it.
# Enables in-process crons: leave escalation, monthly accrual and payout
# reconciliation (polls providers when a payout webhook is missed).
SCHEDULER_ENABLED="false"

# ─── App ───────────────────────────────────────────────────────
NODE_ENV="development"
LOG_LEVEL="debug"
