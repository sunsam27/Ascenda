# ─── Database (Supabase) ───────────────────────────────────────
# Copy the "Session pooler" string from Supabase → Connect and fill in the ref/password.
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require"
SHADOW_DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require"

# ─── JWT ───────────────────────────────────────────────────────
JWT_ACCESS_SECRET="change-me-to-a-random-256-bit-secret"
JWT_REFRESH_SECRET="change-me-to-a-different-random-256-bit-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Redis ─────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Object Storage (S3-compatible) ────────────────────────────
STORAGE_ENDPOINT="https://s3.amazonaws.com"
STORAGE_BUCKET="ascenda-documents"
STORAGE_ACCESS_KEY="your-access-key"
STORAGE_SECRET_KEY="your-secret-key"
STORAGE_REGION="eu-west-1"

# ─── API ───────────────────────────────────────────────────────
API_PORT=3001
API_PREFIX="api/v1"
CORS_ORIGIN="http://localhost:3000"

# ─── Web ───────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
NEXT_PUBLIC_APP_NAME="Ascenda"

# ─── Email (transactional) ─────────────────────────────────────
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="noreply@ascenda.io"
SMTP_PASS="your-smtp-password"
FROM_EMAIL="Ascenda <noreply@ascenda.io>"

# ─── Payments (subscriptions) ──────────────────────────────────
# PAYMENTS_ENABLED: false pauses checkout — paid plans activate without payment
# (useful while building the product). Set to true to require checkout.
PAYMENTS_ENABLED="false"
# Paystack: secret key from Dashboard → Settings → API Keys (sk_test_... / sk_live_...)
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Flutterwave: secret key (FLWSECK_TEST-...) and the webhook secret hash.
FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxx"
FLUTTERWAVE_WEBHOOK_HASH="your-flutterwave-webhook-hash"
# Public URL the gateways should redirect back to after checkout.
WEB_APP_URL="http://localhost:3000"

# ─── App ───────────────────────────────────────────────────────
NODE_ENV="development"
LOG_LEVEL="debug"
