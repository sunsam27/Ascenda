// ─────────────────────────────────────────────────────────────────────────────
// ASCENDA — Prisma Schema
//
// Rules from ARCHITECTURE.md and SECURITY.md:
//   1. All tenant tables carry organisation_id NOT NULL
//   2. UUID primary keys on every table
//   3. created_at, updated_at, created_by on every table
//   4. Money: integer minor units only — no Decimal for payroll amounts
//   5. Row-Level Security is applied via migration SQL (see RLS migration notes)
//   6. Field-level encryption for bank_account_number, national_id, tax_id
//      is done at the application layer — Prisma stores the encrypted bytes
//   7. Effective-dated records: valid_from / valid_to on compensation, leave
//      policy, statutory rule packs
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("DIRECT_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum OrganisationType {
  CHURCH
  SME
  NGO
  SCHOOL
  OTHER
}

enum WorkerCategory {
  EMPLOYEE
  MINISTER
  VOLUNTEER
  CONTRACTOR
  INTERN
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CASUAL
  FIXED_TERM
}

enum WorkerStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
  DRAFT
}

enum SystemRole {
  OWNER
  HR_ADMINISTRATOR
  PAYROLL_ADMINISTRATOR
  FINANCE_APPROVER
  MANAGER
  EMPLOYEE_SELF
  VOLUNTEER_SELF
  AUDITOR
  VIEWER
  SUPPORT_READ_ONLY
}

// ── Billing / plans ──────────────────────────────────────────────────────────

enum BillingPeriod {
  MONTHLY
  ANNUALLY
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum PaymentProvider {
  NONE
  PAYSTACK
  FLUTTERWAVE
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  ABANDONED
  REVERSED
}

/// Self-serve workspace signup. Created before an organisation exists.
/// The password is hashed up-front so verification can complete atomically.
enum RegistrationStatus {
  PENDING
  VERIFIED
  COMPLETED
  CANCELLED
  EXPIRED
}

enum LeaveStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveTypeCategory {
  ANNUAL
  SICK
  MATERNITY
  PATERNITY
  COMPASSIONATE
  STUDY
  UNPAID
  CUSTOM
}

/// How a leave type's entitlement is earned over the leave year (PRD LVE-05).
enum LeaveAccrualMethod {
  /// No automatic accrual; the balance is maintained manually.
  NONE
  /// The full entitlement is available from the start of the leave year.
  ANNUAL_UPFRONT
  /// The entitlement accrues in equal monthly steps across the year.
  MONTHLY
  /// The entitlement accrues pro-rata day by day across the year.
  PRO_RATA
}

enum PayrollRunStatus {
  DRAFT
  IN_REVIEW
  PENDING_APPROVAL
  APPROVED
  PROCESSED
  LOCKED
}

enum PayrollRunApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PayFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
}

enum PayrollItemType {
  BASIC_SALARY
  ALLOWANCE
  BONUS
  DEDUCTION
  EMPLOYER_PENSION
  EMPLOYEE_PENSION
  TAX
  REIMBURSEMENT
  STIPEND
}

/// How a recurring pay item's amount is derived (PRD PAY-02 / PAY-03).
enum PayItemCalculation {
  /// A fixed amount in integer minor units.
  FIXED
  /// A percentage of period gross, stored as basis points (500 = 5%).
  PERCENTAGE
}

/// Reimbursement (PAY-14) lifecycle: submit → manager review → finance
/// approval → folded into a payroll run (PAID).
enum ExpenseClaimStatus {
  SUBMITTED
  MANAGER_APPROVED
  MANAGER_REJECTED
  FINANCE_APPROVED
  FINANCE_REJECTED
  PAID
  CANCELLED
}

/// Where an expense claim sits in its approval chain. Data-driven per org.
enum ExpenseClaimApprovalRole {
  MANAGER
  FINANCE_APPROVER
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REVERSED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  ESCALATED
  DELEGATED
}

enum DocumentType {
  CONTRACT
  ID_DOCUMENT
  PAYSLIP
  OFFER_LETTER
  POLICY
  CERTIFICATION
  OTHER
}

enum AuditAction {
  LOGIN
  LOGIN_FAILED
  LOGOUT
  MFA_CHANGED
  PASSWORD_CHANGED
  ROLE_CHANGED
  PERMISSION_CHANGED
  ORGANISATION_UPDATED
  WORKER_CREATED
  WORKER_UPDATED
  WORKER_DELETED
  COMPENSATION_CHANGED
  BANK_DETAILS_CHANGED
  LEAVE_TYPE_CHANGED
  BLACKOUT_PERIOD_CHANGED
  LEAVE_REQUEST_CREATED
  LEAVE_REQUEST_APPROVED
  LEAVE_REQUEST_REJECTED
  LEAVE_REQUEST_CANCELLED
  LEAVE_REQUEST_ESCALATED
  LEAVE_REQUEST_DELEGATED
  LEAVE_BALANCE_ADJUSTED
  ATTENDANCE_RECORDED
  HOLIDAY_CALENDAR_CHANGED
  PAYROLL_RUN_CREATED
  PAYROLL_RUN_SUBMITTED
  PAYROLL_RUN_APPROVED
  PAYROLL_RUN_REJECTED
  PAYROLL_RUN_PROCESSED
  PAYROLL_RUN_LOCKED
  PAYROLL_RUN_REVERSED
  PAYROLL_ITEM_OVERRIDDEN
  PAY_CALENDAR_CHANGED
  RECURRING_PAY_ITEM_CHANGED
  PAYROLL_CONFIG_CHANGED
  PAYMENT_APPROVED
  PAYMENT_STATUS_CHANGED
  PAYSLIP_GENERATED
  PAYSLIP_ACCESSED
  PAYMENTS_EXPORTED
  YEAR_END_STATEMENT_GENERATED
  YEAR_END_STATEMENT_ACCESSED
  REMITTANCE_SCHEDULE_EXPORTED
  STATUTORY_RULE_PACK_CHANGED
  EXPENSE_CLAIM_CREATED
  EXPENSE_CLAIM_STATUS_CHANGED
  EXPORT_CREATED
  RESTRICTED_FIELD_ACCESSED
  SUPPORT_ACCESS
  DOCUMENT_UPLOADED
  DOCUMENT_ACCESSED
  ACCESS_REQUEST_APPROVED
  ACCESS_REQUEST_REJECTED
  INVITATION_SENT
  PASSWORD_SET
  REGISTRATION_STARTED
  REGISTRATION_VERIFIED
  WORKSPACE_CREATED
  SUBSCRIPTION_ACTIVATED
  PAYMENT_RECEIVED
  PLAN_CREATED
  PLAN_UPDATED
  PLAN_ARCHIVED
}

enum AttendanceSource {
  MANUAL
  CLOCK_IN_OUT
  IMPORT
}

/// PRD ATT-02 attendance statuses.
enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  REMOTE
  ON_LEAVE
  HALF_DAY
  OFF_DAY
}

/// In-app notification kinds. Currently emitted for leave-workflow events
/// (submit / approve / reject / escalate / delegate / cancel) and accrual runs.
enum NotificationType {
  LEAVE_REQUEST_SUBMITTED
  LEAVE_REQUEST_APPROVED
  LEAVE_REQUEST_REJECTED
  LEAVE_REQUEST_ESCALATED
  LEAVE_REQUEST_DELEGATED
  LEAVE_REQUEST_CANCELLED
  LEAVE_ACCRUAL_RUN
}

// ─── Identity & Access ───────────────────────────────────────────────────────

/// Platform-level user account. Credentials managed separately.
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   /// Argon2id hash — NEVER expose in responses
  firstName    String
  lastName     String
  avatarUrl    String?
  isMfaEnabled Boolean  @default(false)
  mfaSecret    String?  /// Encrypted TOTP secret
  /// Ascenda platform staff: may review/approve access requests and provision
  /// workspaces across tenants (SECURITY.md §8 — every action is audited).
  isPlatformAdmin Boolean  @default(false)
  lastLoginAt  DateTime?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships       Membership[]
  auditLogsAsActor  AuditLog[]   @relation("AuditActor")
  notifications     Notification[] @relation("NotificationRecipient")

  @@map("users")
}

/// One membership per (user, organisation) pair. Role evaluated per org.
model Membership {
  id             String     @id @default(uuid())
  organisationId String
  userId         String
  role           SystemRole
  isActive       Boolean    @default(true)
  invitedAt      DateTime   @default(now())
  acceptedAt     DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  createdBy      String

  organisation Organisation @relation(fields: [organisationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([organisationId, userId])
  @@index([organisationId])
  @@index([userId])
  @@map("memberships")
}

// ─── Organisations ───────────────────────────────────────────────────────────

model Organisation {
  id          String           @id @default(uuid())
  name        String
  slug        String           @unique
  type        OrganisationType
  country     String           /// ISO 3166-1 alpha-2
  currency    String           /// ISO 4217
  timezone    String           /// IANA timezone
  terminology Json             @default("{}") /// {"Department":"Ministry","Employee":"Pastor"}
  /// Work-schedule defaults (PRD ATT-02). workDays = ISO weekdays Mon=1..Sun=7.
  workDays         Int[]  @default([1, 2, 3, 4, 5])
  workDayStart     String @default("09:00") /// HH:mm in the organisation timezone
  workDayEnd       String @default("17:00") /// HH:mm in the organisation timezone
  lateGraceMinutes Int    @default(0)
  logoUrl     String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  memberships          Membership[]
  departments          Department[]
  locations            Location[]
  workers              Worker[]
  payCalendars         PayCalendar[]
  payrollRuns          PayrollRun[]
  recurringPayItems    RecurringPayItem[]
  leaveTypes           LeaveType[]
  leaveRequests        LeaveRequest[]
  leaveBalances        LeaveBalance[]
  attendanceRecords    AttendanceRecord[]
  holidayCalendars     Holiday[]
  blackoutPeriods      BlackoutPeriod[]
  approvalWorkflows    ApprovalWorkflow[]
  payments             Payment[]
  payslips             Payslip[]
  expenseClaims        ExpenseClaim[]
  documents            Document[]
  auditLogs            AuditLog[]
  statutoryRulePacks   StatutoryRulePack[]
  yearEndStatements    YearEndStatement[]
  invitations          Invitation[]
  notifications        Notification[]
  subscription         Subscription?

  @@map("organisations")
}

model Department {
  id             String   @id @default(uuid())
  organisationId String
  name           String
  parentId       String?
  managerId      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String

  organisation Organisation @relation(fields: [organisationId], references: [id])
  parent       Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children     Department[] @relation("DepartmentHierarchy")
  workers      Worker[]

  @@index([organisationId])
  @@map("departments")
}

model Location {
  id             String   @id @default(uuid())
  organisationId String
  name           String
  address        String?
  city           String?
  country        String?
  isActive       Boolean  @default(true)
  /// Optional per-location overrides of the organisation's work schedule (ATT-02).
  /// An empty list means "inherit the organisation default".
  workDays         Int[]  @default([])
  workDayStart     String?
  workDayEnd       String?
  lateGraceMinutes Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String

  organisation Organisation @relation(fields: [organisationId], references: [id])
  workers      Worker[]
  holidays     Holiday[]
  blackoutPeriods BlackoutPeriod[]

  @@index([organisationId])
  @@map("locations")
}

// ─── People ──────────────────────────────────────────────────────────────────

model Worker {
  id               String         @id @default(uuid())
  organisationId   String
  userId           String?        /// Linked if they have a login
  employeeNumber   String
  firstName        String
  lastName         String
  preferredName    String?
  email            String
  phone            String?
  category         WorkerCategory
  employmentType   EmploymentType
  status           WorkerStatus   @default(DRAFT)
  jobTitle         String
  departmentId     String?
  locationId       String?
  managerId        String?
  startDate        DateTime
  endDate          DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  createdBy        String

  organisation        Organisation         @relation(fields: [organisationId], references: [id])
  department          Department?          @relation(fields: [departmentId], references: [id])
  location            Location?            @relation(fields: [locationId], references: [id])
  manager             Worker?              @relation("ManagerRelation", fields: [managerId], references: [id])
  directReports       Worker[]             @relation("ManagerRelation")
  compensationRecords CompensationRecord[]
  bankAccounts        BankAccount[]
  leaveRequests       LeaveRequest[]
  leaveBalances       LeaveBalance[]
  attendanceRecords   AttendanceRecord[]
  payrollItems        PayrollItem[]
  recurringPayItems   RecurringPayItem[]
  payments            Payment[]
  payslips            Payslip[]
  expenseClaims       ExpenseClaim[]
  documents           Document[]
  workerIdentity      WorkerIdentity?
  yearEndStatements   YearEndStatement[]

  @@unique([organisationId, employeeNumber])
  @@index([organisationId])
  @@index([organisationId, status])
  @@map("workers")
}

/// Restricted fields — field-level encryption applied at application layer
model WorkerIdentity {
  id                   String   @id @default(uuid())
  organisationId       String
  workerId             String   @unique
  /// Encrypted; display masked last-4 only by default
  nationalIdEncrypted  String?
  nationalIdMasked     String?
  taxIdEncrypted       String?
  taxIdMasked          String?
  nationalIdType       String?
  dateOfBirth          DateTime?
  gender               String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  createdBy            String

  worker Worker @relation(fields: [workerId], references: [id])

  @@index([organisationId])
  @@map("worker_identities")
}

/// Effective-dated — query with valid_from <= date AND (valid_to IS NULL OR valid_to > date)
model CompensationRecord {
  id                    String      @id @default(uuid())
  organisationId        String
  workerId              String
  /// Amount in integer minor currency units — NO FLOATS
  grossAmountMinorUnits Int
  /// Pay-structure components (PRD PAY-01): [{code, label, amountMinorUnits}]
  /// e.g. BASE + HOUSING + TRANSPORT. Server-authoritative: gross is their sum.
  /// Legacy rows may be null; a read synthesises a single BASE component.
  components            Json?
  currency              String
  payFrequency          PayFrequency
  validFrom             DateTime
  validTo               DateTime?
  notes                 String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  createdBy             String

  worker Worker @relation(fields: [workerId], references: [id])

  @@index([organisationId])
  @@index([workerId, validFrom])
  @@map("compensation_records")
}

/// Bank account number stored encrypted at application layer
model BankAccount {
  id                     String   @id @default(uuid())
  organisationId         String
  workerId               String
  bankName               String
  bankCode               String
  accountNumberEncrypted String   /// AES-256-GCM envelope encrypted
  accountNumberMasked    String   /// e.g. "****1234"
  accountName            String
  isVerified             Boolean  @default(false)
  isPrimary              Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  createdBy              String

  worker Worker @relation(fields: [workerId], references: [id])

  @@index([organisationId])
  @@index([workerId])
  @@map("bank_accounts")
}

// ─── Time & Leave ────────────────────────────────────────────────────────────

model LeaveType {
  id               String            @id @default(uuid())
  organisationId   String
  name             String
  category         LeaveTypeCategory
  defaultBalance   Decimal           @db.Decimal(5, 1) /// Days — 0.5 increments OK here (not money)
  isPaid           Boolean
  requiresApproval Boolean           @default(true)
  isActive         Boolean           @default(true)
  /// Accrual policy (PRD LVE-05).
  accrualMethod    LeaveAccrualMethod @default(ANNUAL_UPFRONT)
  carryOverEnabled Boolean            @default(false)
  /// Cap on days carried into the next leave year (null = uncapped).
  carryOverMaxDays Decimal?           @db.Decimal(5, 1)
  /// Months into the new leave year before carried days expire (null = never).
  carryOverExpiryMonths Int?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  createdBy        String

  organisation   Organisation   @relation(fields: [organisationId], references: [id])
  leaveRequests  LeaveRequest[]
  leaveBalances  LeaveBalance[]
  blackoutPeriods BlackoutPeriod[]

  @@index([organisationId])
  @@map("leave_types")
}

model LeaveRequest {
  id                 String      @id @default(uuid())
  organisationId     String
  workerId           String
  leaveTypeId        String
  startDate          DateTime
  endDate            DateTime
  /// Half-day markers (LVE-03): first and/or last day may be a half day.
  startHalfDay       Boolean     @default(false)
  endHalfDay         Boolean     @default(false)
  /// Working days counted at submit — excludes weekends and public holidays.
  days               Decimal     @db.Decimal(5, 2) @default(0)
  status             LeaveStatus @default(DRAFT)
  /// Restricted field — permission-gated (medical_or_leave_reason)
  reasonEncrypted    String?
  submittedAt        DateTime?
  decidedAt          DateTime?
  decidedById        String?
  approvalWorkflowId String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  createdBy          String

  organisation     Organisation      @relation(fields: [organisationId], references: [id])
  worker           Worker            @relation(fields: [workerId], references: [id])
  leaveType        LeaveType         @relation(fields: [leaveTypeId], references: [id])
  approvalWorkflow ApprovalWorkflow? @relation(fields: [approvalWorkflowId], references: [id])

  @@index([organisationId])
  @@index([workerId, status])
  @@map("leave_requests")
}

model LeaveBalance {
  id             String   @id @default(uuid())
  organisationId String
  workerId       String
  leaveTypeId    String
  balance        Decimal  @db.Decimal(5, 1)
  accrued        Decimal  @db.Decimal(5, 1)
  used           Decimal  @db.Decimal(5, 1)
  year           Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id])
  worker       Worker       @relation(fields: [workerId], references: [id])
  leaveType    LeaveType    @relation(fields: [leaveTypeId], references: [id])

  @@unique([organisationId, workerId, leaveTypeId, year])
  @@index([organisationId])
  @@map("leave_balances")
}

model AttendanceRecord {
  id             String           @id @default(uuid())
  organisationId String
  workerId       String
  date           DateTime         @db.Date
  clockIn        DateTime?
  clockOut       DateTime?
  hoursWorked    Decimal?         @db.Decimal(4, 2)
  source         AttendanceSource @default(MANUAL)
  status         AttendanceStatus @default(PRESENT)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  createdBy      String

  organisation Organisation @relation(fields: [organisationId], references: [id])
  worker       Worker       @relation(fields: [workerId], references: [id])

  @@unique([organisationId, workerId, date])
  @@index([organisationId])
  @@index([workerId, date])
  @@map("attendance_records")
}

// ─── Payroll ─────────────────────────────────────────────────────────────────

// ─── Holidays ────────────────────────────────────────────────────────────────

/// Public-holiday calendar (PRD LVE-03). `locationId = null` applies to the
/// whole organisation; a non-null value scopes the holiday to one location.
model Holiday {
  id             String   @id @default(uuid())
  organisationId String
  locationId     String?
  name           String
  date           DateTime @db.Date
  /// Repeats every year on the same month/day (e.g. New Year's Day).
  isRecurring    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String

  organisation Organisation @relation(fields: [organisationId], references: [id])
  location     Location?    @relation(fields: [locationId], references: [id])

  @@index([organisationId])
  @@index([organisationId, locationId, date])
  @@map("holidays")
}

/// Date windows when leave may not normally be taken (PRD LVE-05). Org-wide when
/// `locationId` and `leaveTypeId` are null; scoped when set.
model BlackoutPeriod {
  id             String   @id @default(uuid())
  organisationId String
  locationId     String?
  leaveTypeId    String?
  name           String
  startDate      DateTime @db.Date
  endDate        DateTime @db.Date
  /// Repeats every year on the same month/day range (e.g. year-end shutdown).
  isRecurring    Boolean  @default(false)
  reason         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String

  organisation Organisation @relation(fields: [organisationId], references: [id])
  location     Location?    @relation(fields: [locationId], references: [id])
  leaveType    LeaveType?   @relation(fields: [leaveTypeId], references: [id])

  @@index([organisationId])
  @@index([organisationId, locationId, startDate])
  @@map("blackout_periods")
}

model PayCalendar {
  id             String      @id @default(uuid())
  organisationId String
  name           String
  frequency      PayFrequency
  dayOfMonth     Int?
  dayOfWeek      Int?
  /// Cut-off day-of-month (PAY-04): changes after this day in the pay month
  /// wait for the next run. Null means no cut-off.
  cutOffDayOfMonth Int?
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  createdBy      String

  organisation Organisation @relation(fields: [organisationId], references: [id])
  payrollRuns  PayrollRun[]

  @@index([organisationId])
  @@map("pay_calendars")
}

/// Run states are strictly one-way: DRAFT → IN_REVIEW → PENDING_APPROVAL → APPROVED → PROCESSED → LOCKED
/// Approved runs are immutable; fixes use reversal or next-run adjustments.
model PayrollRun {
  id                      String           @id @default(uuid())
  organisationId          String
  payCalendarId           String
  periodStart             DateTime
  periodEnd               DateTime
  status                  PayrollRunStatus @default(DRAFT)
  preparedById            String
  /// Separation of duties: preparer != approver
  approvedById            String?
  approvedAt              DateTime?
  lockedAt                DateTime?
  /// PAY-07/06: who submitted for approval, and when warnings were acknowledged.
  submittedById            String?
  submittedAt              DateTime?
  validationAcknowledgedAt DateTime?
  validationAcknowledgedById String?
  /// PAY-06: a reversal run points at the run it reverses; the original is
  /// stamped with reversedAt and can never be edited (corrections flow through
  /// the reversal run or the next period).
  reversalOfRunId         String?
  reversedAt              DateTime?
  /// All money in minor units
  totalGrossMinorUnits    Int              @default(0)
  totalNetMinorUnits      Int              @default(0)
  totalDeductionsMinorUnits Int            @default(0)
  currency                String
  notes                   String?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  createdBy               String

  organisation Organisation  @relation(fields: [organisationId], references: [id])
  payCalendar  PayCalendar   @relation(fields: [payCalendarId], references: [id])
  items        PayrollItem[]
  payments     Payment[]
  payslips     Payslip[]
  approvals    PayrollRunApproval[]

  @@index([organisationId])
  @@index([organisationId, status])
  @@index([reversalOfRunId])
  @@map("payroll_runs")
}

model PayrollItem {
  id                 String          @id @default(uuid())
  organisationId     String
  payrollRunId       String
  workerId           String
  type               PayrollItemType
  description        String
  /// Positive for earnings, negative for deductions — integer minor units
  amountMinorUnits   Int
  currency           String
  /// PAY-09: set when the line was manually overridden after prepare; the
  /// reason is mandatory and the change itself is audit-logged.
  overrideReason     String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  worker     Worker     @relation(fields: [workerId], references: [id])
  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id])

  @@index([organisationId])
  @@index([payrollRunId])
  @@index([workerId])
  @@map("payroll_items")
}

/// PAY-11: one row per configured approval step, snapshotted onto the run when
/// it is submitted. The run is approved only when every step is APPROVED.
model PayrollRunApproval {
  id            String                   @id @default(uuid())
  organisationId String
  payrollRunId  String
  /// 1-based position in the configured chain.
  stepNumber    Int
  /// The system role that must satisfy this step (e.g. OWNER, FINANCE_APPROVER).
  role          SystemRole
  status        PayrollRunApprovalStatus @default(PENDING)
  actorId       String?
  comment       String?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id])

  @@unique([payrollRunId, stepNumber])
  @@index([organisationId])
  @@index([payrollRunId])
  @@map("payroll_run_approvals")
}

/// PAY-10/11: per-organisation payroll settings — approval chain and the
/// configurable validation thresholds. Absent row = documented defaults.
model PayrollConfig {
  id                      String   @id @default(uuid())
  organisationId          String   @unique
  /// Ordered approver roles, e.g. ["FINANCE_APPROVER","OWNER"]. Default ["OWNER"]
  /// (for small orgs the Payroll Administrator signs off by submitting).
  approvalChain           String[] @default(["OWNER"])
  /// Warn when a worker's gross rises more than this % vs the previous run.
  salaryChangeWarnPct     Int      @default(30)
  /// Warn when a worker's deductions exceed this share of gross (bps, 5000 = 50%).
  deductionRatioWarnBps   Int      @default(5000)
  /// Blocking error when a run worker has no bank account on file.
  requireBankDetails      Boolean  @default(true)
  /// PAY-16: month the organisation's tax/leave year starts (1 = January). The
  /// year boundary is configuration data, not an assumption (LOC-02).
  taxYearStartMonth       Int      @default(1)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  updatedBy               String?

  @@map("payroll_config")
}

/// Per-worker recurring deductions and employer-side costs (PRD PAY-02 / PAY-03).
/// Effective-dated and tenant-scoped. Amounts are stored as positive magnitudes
/// in integer minor units; the payroll run engine applies the sign and the
/// employee/employer partition derived from `type` (EMPLOYER_PENSION is an
/// employer cost, never net-deducted). Statutory rates are org-configured data
/// here — never hard-coded per country.
model RecurringPayItem {
  id                 String              @id @default(uuid())
  organisationId     String
  workerId           String
  /// DEDUCTION | TAX | EMPLOYEE_PENSION | EMPLOYER_PENSION (allow-listed in the DTO)
  type               PayrollItemType
  /// Human label, e.g. "Cooperative", "Salary advance", "Employer pension".
  name               String
  calculation        PayItemCalculation
  /// FIXED: positive integer minor units. Null when calculation = PERCENTAGE.
  amountMinorUnits   Int?
  /// PERCENTAGE: basis points of period gross (500 = 5%). Null when FIXED.
  rateBps            Int?
  validFrom          DateTime
  validTo            DateTime?
  isActive           Boolean             @default(true)
  notes              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  createdBy          String

  organisation Organisation @relation(fields: [organisationId], references: [id])
  worker       Worker       @relation(fields: [workerId], references: [id])

  @@index([organisationId])
  @@index([organisationId, workerId, isActive])
  @@index([workerId, validFrom])
  @@map("recurring_pay_items")
}

/// Effective-dated country/statutory rule packs — NEVER hard-code tax rules
model StatutoryRulePack {
  id             String   @id @default(uuid())
  organisationId String
  country        String
  version        String
  rules          Json     /// Versioned rule configuration
  validFrom      DateTime
  validTo        DateTime?
  isActive       Boolean  @default(true)
  /// LOC-03: false until a qualified professional has validated this pack.
  validated      Boolean  @default(false)
  validatedBy    String?
  validatedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String

  organisation Organisation @relation(fields: [organisationId], references: [id])

  @@index([organisationId, country, validFrom])
  @@map("statutory_rule_packs")
}

// ─── Payments ────────────────────────────────────────────────────────────────

model Payment {
  id                   String        @id @default(uuid())
  organisationId       String
  payrollRunId         String?
  workerId             String
  /// Integer minor units
  amountMinorUnits     Int
  currency             String
  status               PaymentStatus @default(PENDING)
  reference            String        @unique
  description          String
  processedAt          DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  createdBy            String

  organisation Organisation @relation(fields: [organisationId], references: [id])
  payrollRun   PayrollRun?  @relation(fields: [payrollRunId], references: [id])
  worker       Worker       @relation(fields: [workerId], references: [id])

  @@index([organisationId])
  @@index([workerId, status])
  @@map("payments")
}

// ─── Payslips (PAY-13) ───────────────────────────────────────────────────────

/// One payslip per worker per processed run. Totals equal the sum of the run's
/// item lines for that worker. The PDF itself is rendered on demand; this row
/// is the immutable record of what was paid and when.
model Payslip {
  id                 String   @id @default(uuid())
  organisationId     String
  payrollRunId       String
  workerId           String
  /// Pay-period label, e.g. "September 2026".
  periodLabel        String
  periodStart        DateTime
  periodEnd          DateTime
  currency           String
  grossMinorUnits    Int
  deductionsMinorUnits Int    @default(0)
  employerCostsMinorUnits Int  @default(0)
  netMinorUnits      Int
  /// Frozen line items (earnings + deductions) as printed on the document.
  lines              Json     @default("[]")
  /// When the payslip became available to the worker (email notification sent).
  availableAt        DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id])
  payrollRun   PayrollRun   @relation(fields: [payrollRunId], references: [id])
  worker       Worker       @relation(fields: [workerId], references: [id])

  @@unique([payrollRunId, workerId])
  @@index([organisationId])
  @@index([workerId])
  @@map("payslips")
}

// ─── Year-end statements (PAY-16) ─────────────────────────────────────────────

/// One frozen annual statement per worker per tax year. Totals equal the sum of
/// the worker's payslips inside the tax-year window. Immutable once generated;
/// regenerating for the same worker + year is a no-op (idempotent). Reporting
/// artefact only — Ascenda never moves funds.
model YearEndStatement {
  id                 String   @id @default(uuid())
  organisationId     String
  workerId           String
  /// Tax-year label, e.g. "2026" or "2026/2027".
  taxYearLabel       String
  periodStart        DateTime
  periodEnd          DateTime
  currency           String
  grossMinorUnits    Int
  deductionsMinorUnits Int    @default(0)
  employerCostsMinorUnits Int  @default(0)
  netMinorUnits      Int
  /// Rolled-up annual lines (per pay type) as printed on the statement.
  lines              Json     @default("[]")
  /// Number of payslips aggregated into this statement.
  payslipCount       Int      @default(0)
  /// LOC-03: false if any contributing statutory pack was not validated.
  validatedByProfessional Boolean @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id])
  worker       Worker       @relation(fields: [workerId], references: [id])

  @@unique([organisationId, workerId, taxYearLabel])
  @@index([organisationId])
  @@index([workerId])
  @@map("year_end_statements")
}

// ─── Reimbursements (PAY-14) ─────────────────────────────────────────────────

/// Reimbursement / expense claim. Flows: SUBMITTED → MANAGER_APPROVED →
/// FINANCE_APPROVED → folded into the next run (PAID). Amounts are positive
/// integer minor units; a receipt is stored as a document reference/URL.
model ExpenseClaim {
  id               String               @id @default(uuid())
  organisationId   String
  workerId         String
  /// REIMBURSEMENT | EXPENSE | TRAVEL | ... (org-defined label, free text).
  type             String
  description      String
  /// Positive integer minor units.
  amountMinorUnits Int
  currency         String
  /// Receipt reference (uploaded document id or external URL).
  receiptUrl       String?
  status           ExpenseClaimStatus   @default(SUBMITTED)
  /// Whoever approved/rejected the current step.
  managerDecidedById  String?
  managerDecidedAt    DateTime?
  managerComment      String?
  financeDecidedById  String?
  financeDecidedAt    DateTime?
  financeComment      String?
  /// Set when the claim is attached to a payroll run as a reimbursement line.
  paidPayrollRunId String?
  paidAt           DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  createdBy        String

  organisation Organisation @relation(fields: [organisationId], references: [id])
  worker       Worker       @relation(fields: [workerId], references: [id])

  @@index([organisationId])
  @@index([organisationId, status])
  @@index([workerId, status])
  @@map("expense_claims")
}

// ─── Approvals ───────────────────────────────────────────────────────────────

model ApprovalWorkflow {
  id             String         @id @default(uuid())
  organisationId String
  name           String
  resourceType   String         /// "leave_request" | "payroll_run" | "payment" etc
  resourceId     String
  currentStep    Int            @default(0)
  status         ApprovalStatus @default(PENDING)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  createdBy      String

  organisation  Organisation    @relation(fields: [organisationId], references: [id])
  steps         ApprovalStep[]
  leaveRequests LeaveRequest[]

  @@index([organisationId])
  @@index([resourceType, resourceId])
  @@map("approval_workflows")
}

model ApprovalStep {
  id                 String         @id @default(uuid())
  approvalWorkflowId String
  stepOrder          Int
  approverId         String
  status             ApprovalStatus @default(PENDING)
  actedAt            DateTime?
  note               String?
  delegatedToId      String?
  /// Escalation (LVE-04): minutes after the step becomes active before it
  /// auto-escalates, and the computed deadline / escalation record.
  escalateAfterMinutes Int?
  dueAt                DateTime?
  escalatedAt          DateTime?
  escalatedToId        String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  workflow ApprovalWorkflow @relation(fields: [approvalWorkflowId], references: [id])

  @@index([approvalWorkflowId])
  @@index([status, dueAt])
  @@map("approval_steps")
}

// ─── Documents ───────────────────────────────────────────────────────────────

model Document {
  id             String       @id @default(uuid())
  organisationId String
  workerId       String?
  type           DocumentType
  name           String
  /// Private storage key — never expose directly; use signed URLs
  storageKey     String
  mimeType       String
  sizeBytes      Int
  uploadedBy     String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organisation Organisation? @relation(fields: [organisationId], references: [id])
  worker       Worker?       @relation(fields: [workerId], references: [id])

  @@index([organisationId])
  @@index([workerId, type])
  @@map("documents")
}

// ─── Audit Log ───────────────────────────────────────────────────────────────

/// Append-only. Application DB role has INSERT only — no UPDATE or DELETE on this table.
model AuditLog {
  id             String      @id @default(uuid())
  organisationId String
  actorId        String
  actorEmail     String
  action         AuditAction
  targetType     String
  targetId       String
  /// Sensitive values masked (e.g. bank number → "****1234")
  previousValue  Json?
  newValue       Json?
  ipAddress      String
  userAgent      String
  timestamp      DateTime    @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id])
  actor        User         @relation("AuditActor", fields: [actorId], references: [id])

  @@index([organisationId, timestamp])
  @@index([actorId])
  @@index([targetType, targetId])
  @@map("audit_log")
}

// ─── Invitations (onboarding) ────────────────────────────────────────────────
// Created when a platform admin invites someone (or during self-serve signup).
// The raw token is emailed to the invitee; only its SHA-256 hash is stored.
// Single-use and time-limited. NOT tenant-scoped: the public set-password
// endpoint must look it up by token before any organisation context exists.
// Organisation context is applied only to the write that finalises the
// membership.

model Invitation {
  id             String    @id @default(uuid())
  organisationId String
  email          String
  role           SystemRole
  /// SHA-256 hex of the raw invitation token — never store the token itself.
  tokenHash      String    @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  /// Platform admin who created the invitation.
  createdBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id])

  @@index([organisationId])
  @@index([email])
  @@map("invitations")
}

// ─── Notifications ───────────────────────────────────────────────────────────
// Per-recipient, in-app notifications (the bell in the app shell). Tenant-scoped
// (RLS on `organisationId`); the recipient is a platform user, not a worker.
// A read receipt is a non-null `readAt`. Delivery is best-effort: email is sent
// alongside in-app rows when SMTP is configured.

model Notification {
  id              String           @id @default(uuid())
  organisationId  String
  recipientUserId String
  type            NotificationType
  title           String
  body            String
  /// Relative in-app link (e.g. /time-leave) to open on click.
  link            String?
  /// Small structured payload for future deep-linking (never secrets).
  metadata        Json?
  readAt          DateTime?
  createdAt       DateTime         @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id])
  recipient    User         @relation("NotificationRecipient", fields: [recipientUserId], references: [id])

  @@index([organisationId, recipientUserId, createdAt])
  @@index([recipientUserId, readAt])
  @@map("notifications")
}

// ─── Plans (platform-editable pricing) ───────────────────────────────────────
// NOT tenant-scoped. Publicly readable (active plans); writable by platform
// admins only. Money is stored in minor units (kobo) — never floats.

model Plan {
  id              String        @id @default(uuid())
  code            String        @unique
  name            String
  description     String?
  /// Price per billing period, in minor currency units (e.g. kobo for NGN).
  priceMinorUnits Int           @default(0)
  currency        String        @default("NGN")
  billingPeriod   BillingPeriod @default(ANNUALLY)
  /// Inclusive headcount band this plan is recommended for (UI hint + limits).
  minHeadcount    Int?
  maxHeadcount    Int?
  /// Max seats; null means unlimited.
  maxSeats        Int?
  /// Display bullet points, e.g. ["Unlimited payroll runs", "Priority support"].
  features        Json          @default("[]")
  isFree          Boolean       @default(false)
  isActive        Boolean       @default(true)
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  subscriptions Subscription[]

  @@index([isActive])
  @@map("plans")
}

// ─── Subscriptions (one active plan per organisation) ────────────────────────
// Tenant-scoped (RLS). Created during signup provisioning.

model Subscription {
  id                 String             @id @default(uuid())
  organisationId     String             @unique
  planId             String
  status             SubscriptionStatus @default(PENDING)
  provider           PaymentProvider    @default(NONE)
  providerRef        String?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organisation Organisation          @relation(fields: [organisationId], references: [id])
  plan         Plan                  @relation(fields: [planId], references: [id])
  transactions BillingTransaction[]

  @@index([planId])
  @@map("subscriptions")
}

// ─── Billing transactions ────────────────────────────────────────────────────
// One row per gateway charge attempt. NOT tenant-scoped at creation time (the
// org may not exist yet), so it links to an organisation once provisioned.

model BillingTransaction {
  id              String            @id @default(uuid())
  provider        PaymentProvider
  /// Gateway reference we generated and send to the provider (unique).
  reference       String            @unique
  /// Provider-assigned transaction id (Paystack id / Flutterwave tx id).
  providerTxnId   String?
  amountMinorUnits Int
  currency        String            @default("NGN")
  status          TransactionStatus @default(PENDING)
  payerEmail      String
  planId          String?
  registrationId  String?
  organisationId  String?
  subscriptionId  String?
  /// Raw provider payload for reconciliation (never contains card data).
  raw             Json?
  paidAt          DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([status])
  @@index([registrationId])
  @@index([organisationId])
  @@map("billing_transactions")
}

// ─── Registrations (self-serve signup) ───────────────────────────────────────
// NOT tenant-scoped: created before an organisation exists. Email verification
// is a 6-digit code; only its SHA-256 hash is stored. Single-use / time-limited.

model Registration {
  id                    String             @id @default(uuid())
  firstName             String
  lastName              String
  email                 String
  phone                 String?
  /// Argon2id hash captured at signup; applied to the user on provisioning.
  passwordHash          String
  organisationName      String
  organisationType      OrganisationType
  teamSize              String
  country               String             @default("NG")
  role                  String?
  message               String?
  /// Selected plan (code snapshot kept so we can provision after payment).
  planId                String
  planCode              String
  status                RegistrationStatus @default(PENDING)
  /// SHA-256 hex of the 6-digit verification code — never store the code.
  verificationCodeHash  String?
  verificationExpiresAt DateTime?
  verificationAttempts  Int                @default(0)
  verifiedAt            DateTime?
  /// Set once the workspace has been provisioned.
  organisationId        String?
  userId                String?
  ipAddress             String?
  userAgent             String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([email])
  @@index([status])
  @@map("registrations")
}
