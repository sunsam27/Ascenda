{
  "name": "@ascenda/db",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma schema, migrations and seed for Ascenda",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "prisma generate && tsc",
    "type-check": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:rls": "node --env-file=.env scripts/apply-sql.cjs migrations/00_rls_setup.sql",
    "db:integrity": "node --env-file=.env scripts/apply-sql.cjs migrations/01_payroll_integrity.sql",
    "db:isolation-test": "node --env-file=.env scripts/isolation-test.cjs",
    "db:studio": "prisma studio",
    "clean": "rm -rf dist"
  },
  "prisma": {
    "seed": "node -r ts-node/register/transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "argon2": "^0.43.0"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "typescript": "^5.7.3",
    "ts-node": "^10.9.2",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "pg": "^8.13.1"
  }
}
